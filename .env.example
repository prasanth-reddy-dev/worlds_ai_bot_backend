# ================================
# WORLDS AI BOT - BACKEND SECRETS
# ================================
# Copy this file to .env and fill in your values

# =============
# DATABASE
# =============
# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017/worlds_ai_bot
# For MongoDB Atlas use: mongodb+srv://username:password@cluster.mongodb.net/worlds_ai_bot

# =============
# JWT AUTHENTICATION
# =============
# IMPORTANT: Change this to a strong secret in production!
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# =============
# CORS SETTINGS
# =============
# Frontend URL(s) for CORS - comma separated for multiple
FRONTEND_URL=http://localhost:5173
CORS_CREDENTIALS=true

# =============
# EMAIL CONFIGURATION
# =============
# For password reset emails
# For Gmail, use App Password: https://support.google.com/accounts/answer/185833
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# =============
# PAYMENT GATEWAY
# =============
# Razorpay credentials - get from https://dashboard.razorpay.com/
# Test mode keys start with 'rzp_test_'
# Live mode keys start with 'rzp_live_'
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# =============
# OPTIONAL: PRODUCTION SETTINGS
# =============
# Set to 'production' for deployment
FLASK_ENV=development
# Server port
PORT=5001
